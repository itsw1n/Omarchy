      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "\u2502 \u251c\uf489",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "\u2502 \u251c\udb80\udfd6",
      "keyColor": "blue"
    },
    {
      "type": "wmtheme",
      "key": "\u2502 \u251c\udb80\ude7c",
      "keyColor": "blue"
    },
    {
      "type": "command",
      "key": "\u2502 \u251c\udb83\ude0c",
      "keyColor": "blue",
      "text": "theme=$(omarchy-theme-current); echo -e \"$theme \\e[38m\u25cf\\e[37m\u25cf\\e[36m\u25cf\\e[35m\u25cf\\e[34m\u25cf\\e[33m\u25cf\\e[32m\u25cf\\e[31m\u25cf\""
    },
    {
      "type": "terminalfont",
      "key": "\u2514 \u2514\uf031",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "\u001b[90m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500Age / Uptime / Update\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510"
    },
    {
      "type": "command",
      "key": "\udb86\udd9f OS Age",
      "keyColor": "magenta",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
    },
    {
      "type": "uptime",
      "key": "\udb86\uded0 Uptime",
      "keyColor": "magenta"
    },
    {
      "type": "command",
      "key": "\ueb29 Update",
      "keyColor": "magenta",
      "text": "updated=$(omarchy-version-pkgs); echo \"$updated\""
    },
    {
      "type": "custom",
      "format": "\u001b[90m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518"
