#!/bin/bash
# Windows-style Win+P display mode picker. Works on Omarchy 3.x (Walker) and
# quattro/v4 (omarchy-menu-select).
set -uo pipefail

notify() {
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send -g 󰍹 "$1"
  else
    notify-send -u low "󰍹    Display Mode" "$1"
  fi
}

pick() {
  if command -v omarchy-menu-select >/dev/null 2>&1; then
    omarchy-menu-select "Display mode" Duplicate Extend "External only" "Internal only"
  elif command -v walker >/dev/null 2>&1; then
    printf "Duplicate\nExtend\nExternal only\nInternal only" | walker --dmenu -p "Display mode:" -n
  else
    return 1
  fi
}

EXTERNAL=$(hyprctl monitors -j | jq -r '.[] | select(.name | test("^(eDP|LVDS|DSI)-") | not) | .name' | head -n 1)
if [[ -z "$EXTERNAL" ]]; then
  notify "No external display detected"
  exit 0
fi

CHOICE=$(pick) || { notify "No menu available"; exit 1; }
[[ -n "$CHOICE" ]] || exit 0

case "$CHOICE" in
  "Duplicate")
    omarchy-hyprland-monitor-internal-mirror on
    notify "Mirrored"
    ;;
  "Extend")
    omarchy-hyprland-monitor-internal-mirror off
    omarchy-hyprland-monitor-internal on
    hyprctl reload
    notify "Extended mode"
    ;;
  "External only")
    omarchy-hyprland-monitor-internal-mirror off
    omarchy-hyprland-monitor-internal off
    notify "External only"
    ;;
  "Internal only")
    omarchy-hyprland-monitor-internal-mirror off
    omarchy-hyprland-monitor-internal on
    for ext in $(hyprctl monitors -j | jq -r '.[] | select(.name | test("^(eDP|LVDS|DSI)-") | not) | .name'); do
      hyprctl keyword monitor "$ext,disable"
    done
    notify "Internal only"
    ;;
esac
