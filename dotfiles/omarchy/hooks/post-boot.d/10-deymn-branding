#!/usr/bin/env bash
# Restore DEYMN branding after boot / after the quattro upgrade.
set -uo pipefail

REPO_ROOT="$HOME/Files/omarchy-setup"

# The quattro upgrade overwrites screensaver.txt with the stock logo.
SRC="$REPO_ROOT/dotfiles/omarchy/branding/screensaver.txt"
DST="$HOME/.config/omarchy/branding/screensaver.txt"
if [[ -f "$SRC" ]]; then
  mkdir -p "$(dirname "$DST")"
  if ! cmp -s "$SRC" "$DST" 2>/dev/null; then
    cp "$SRC" "$DST"
    echo "DEYMN screensaver branding restored."
  fi
fi

[[ -x "$REPO_ROOT/scripts/deymn-plymouth-logo" ]] && "$REPO_ROOT/scripts/deymn-plymouth-logo"
exit 0
