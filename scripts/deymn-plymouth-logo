#!/usr/bin/env bash
# Recolor the DEYMN gray logo with the active theme accent and deploy it to
# Plymouth (boot) and SDDM (login). Works on Omarchy 3.x and quattro (v4):
# it never patches Omarchy's own scripts.
set -uo pipefail

REPO_ROOT="${REPO_ROOT:-$HOME/Files/omarchy-setup}"
DEYMN_GRAY="${DEYMN_GRAY:-/usr/local/share/deymn-plymouth/logov2_gray.png}"
THEME_DIR="/usr/share/plymouth/themes/omarchy"
SDDM_DIR="/usr/share/sddm/themes/omarchy"

[[ -f "$DEYMN_GRAY" ]] || DEYMN_GRAY="$REPO_ROOT/assets/logo/logov2_gray.png"
if [[ ! -f "$DEYMN_GRAY" ]]; then
  echo "deymn-plymouth-logo: DEYMN gray logo not found; skipping" >&2
  exit 0
fi
command -v magick >/dev/null 2>&1 || {
  echo "deymn-plymouth-logo: ImageMagick (magick) not installed; skipping" >&2
  exit 0
}

THEME_NAME=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null \
  || cat "$HOME/.config/omarchy/current/theme.name" 2>/dev/null || true)

COLORS_TOML=""
for candidate in \
  "$HOME/.config/omarchy/themes/$THEME_NAME/colors.toml" \
  "$HOME/.local/state/omarchy/current/theme/colors.toml" \
  "$HOME/.local/share/omarchy/themes/$THEME_NAME/colors.toml" \
  "/usr/share/omarchy/themes/$THEME_NAME/colors.toml"; do
  if [[ -n "$THEME_NAME" && -f "$candidate" ]]; then
    COLORS_TOML="$candidate"
    break
  fi
done

accent=$(awk -F'"' '/^accent/{print $2}' "$COLORS_TOML" 2>/dev/null || true)
if [[ -z "$accent" ]]; then
  echo "deymn-plymouth-logo: could not read accent color; skipping" >&2
  exit 0
fi

STAGING=$(mktemp -d)
trap 'rm -rf "$STAGING"' EXIT
magick "$DEYMN_GRAY" -channel RGB +level-colors "${accent}","${accent}" "$STAGING/logo.png" || exit 0

# Never hang an unattended update on a password prompt.
if ! sudo -n true 2>/dev/null; then
  echo "deymn-plymouth-logo: sudo not cached; logo staged at $STAGING/logo.png (skipping deploy)" >&2
  exit 0
fi

changed=0
if ! sudo -n cmp -s "$STAGING/logo.png" "$THEME_DIR/logo.png" 2>/dev/null; then
  sudo -n cp "$STAGING/logo.png" "$THEME_DIR/logo.png" && changed=1
fi
sudo -n cp "$STAGING/logo.png" "$SDDM_DIR/logo.png" 2>/dev/null || true

if (( changed )); then
  if command -v limine-mkinitcpio >/dev/null 2>&1; then
    sudo -n limine-mkinitcpio >/dev/null 2>&1 || sudo -n mkinitcpio -P >/dev/null 2>&1 || true
  else
    sudo -n mkinitcpio -P >/dev/null 2>&1 || true
  fi
fi

echo "deymn-plymouth-logo: deployed ($THEME_NAME accent: $accent)"
